# Copy to .env. Both values come from Supabase → Settings → API.
#
# The anon key belongs in the client — it is designed to be public and RLS is
# what actually protects the data. The service_role key bypasses every policy in
# backend/schema.sql and must never appear in the app, in .env, or in a build.
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle at build time. Anything
# named this way is readable by anyone who downloads the app. That is fine for
# these two and fine for nothing else.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google's WEB client id — the one Supabase already uses, not the Android one.
# Native sign-in asks Google for an ID token minted for this audience, and that is
# the audience Supabase verifies. The Android client must exist too (package
# com.safar.app plus the debug SHA-1), because it is what authorises this app to
# ask at all; its id goes into Supabase's provider settings, not here.
#
# Leave this blank and sign-in falls back to the browser flow. That works, but it
# hands control to Chrome, and a low-memory phone will kill the app mid-flight.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
